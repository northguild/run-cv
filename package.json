{
  "name": "run-cv",
  "version": "0.2.3",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "run-cv": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/northguild/run-cv"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "biome check && tsup src/cli.tsx --format esm --clean && pnpm run copy:humans && pnpm run build:pdfs && pnpm run copy:pdfs",
    "build:ci": "biome check && tsup src/cli.tsx --format esm --clean && pnpm run copy:humans",
    "build:pdfs": "tsx scripts/pdf-gen/generate.ts --all",
    "predev": "pnpm run build:pdfs && pnpm run copy:pdfs",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "biome:all": "biome format --write && biome lint --write",
    "gen:pdf": "tsx scripts/pdf-gen/generate.ts",
    "copy:pdfs": "tsx scripts/copy-pdfs/copy-pdfs.ts",
    "copy:humans": "cp -r src/humans dist/",
    "gen:json": "tsx scripts/json-gen/generate.ts",
    "prepublishOnly": "pnpm run build",
    "build:web": "node scripts/run-cv-web/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p scripts/run-cv-web --noEmit",
    "preview:web": "node scripts/run-cv-web/preview.mjs"
  },
  "keywords": [],
  "author": "Craig O. Curtis & Baldur Páll Hólmgeirsson",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "ink": "^6.8.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.0",
    "ink-select-input": "^6.2.0",
    "marked": "^12.0.1",
    "meow": "^12.1.1",
    "nodemailer": "^8.0.1",
    "open": "^10.2.0",
    "react": "^19.2.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.6.2",
    "@types/nodemailer": "^6.4.10",
    "@types/react": "^19.2.14",
    "@types/uuid": "^10.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^30.0.1",
    "memfs": "^4.76.0",
    "path-browserify": "^1.0.1",
    "playwright-core": "^1.58.2",
    "stream-browserify": "^3.0.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "util": "^0.12.5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
